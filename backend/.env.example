# Copia este archivo como .env (en la carpeta backend/) y ajusta los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Si una variable también existe en el sistema operativo, esa tiene prioridad.

# Puerto del servidor (API + sitio web compilado)
PORT=8080

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maykel_repuestos2
DB_USER=postgres
DB_PASS=Emma260112

# Token que usa el agente local de bodega para sincronizar stock
# (POST /api/v1/sync/inventory con cabecera "Authorization: Bearer <token>")
SYNC_API_TOKEN=cambia_este_token

# Opcional: usuarios de emergencia para el panel, aparte de la tabla usuarios.
# Formato usuario:clave,usuario2:clave2. Déjalo vacío si no lo necesitas.
# ADMIN_USERS=

# Notificaciones de reservas (opcionales; si faltan, no se envía nada).
# WhatsApp Cloud API (Meta): token permanente, ID del número y destino (con código de país, sin +)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_DESTINO=56912345678
# Correo SMTP (ej. Gmail: smtp.gmail.com, puerto 587, clave de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SSL=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_DESTINO=ventas@ejemplo.cl,otro@ejemplo.cl

# Firma de sesiones (JWT): cadena larga y aleatoria (>= 16 caracteres). Obligatoria en produccion.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
# JWT_HORAS=8

# Conector con el sistema del cliente (agente --sistema). Bodega 2 = Sucursal.
SISTEMA_URL=https://sistema.maykelrepuestos.cl
SISTEMA_EMAIL=
SISTEMA_PASS=
SISTEMA_BODEGAS=2
