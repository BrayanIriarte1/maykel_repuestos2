# Copia este archivo como .env (en la carpeta backend/) y ajusta los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Si una variable también existe en el sistema operativo, esa tiene prioridad.

# Puerto del servidor (API + sitio web compilado)
PORT=8080

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maykel_repuestos2
DB_USER=postgres
DB_PASS=Emma260112

# Token que usa el agente local de bodega para sincronizar stock
# (POST /api/v1/sync/inventory con cabecera "Authorization: Bearer <token>")
SYNC_API_TOKEN=cambia_este_token

# Opcional: usuarios de emergencia para el panel, aparte de la tabla usuarios.
# Formato usuario:clave,usuario2:clave2. Déjalo vacío si no lo necesitas.
# ADMIN_USERS=
